# TaskFlow Environment Variables Configuration

# ----------------------------------------------------
# BACKEND CONFIGURATION
# Location: backend/.env
# ----------------------------------------------------
# PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow_db"

# Secret key used for signing JSON Web Tokens
JWT_SECRET="your-super-secret-jwt-key"

# JWT Expiration time (e.g., "1d", "7d", "1h")
JWT_EXPIRES_IN="7d"

# The origin of the web client for CORS (e.g. http://localhost:5173 for local, or your Vercel URL)
CLIENT_ORIGIN="http://localhost:5173"

# Port for the Node.js Express server to run on
PORT=3000

# Environment (development or production)
NODE_ENV="development"

# ----------------------------------------------------
# MOBILE CONFIGURATION
# Location: mobile/.env
# ----------------------------------------------------
# The URL pointing to your backend API
# If testing on a physical device, use your computer's local IP address (e.g. http://192.168.1.5:3000/api)
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000/api"

# ----------------------------------------------------
# WEB CONFIGURATION
# Location: web/.env
# ----------------------------------------------------
# The URL pointing to your backend API
VITE_API_URL="http://localhost:3000/api"
